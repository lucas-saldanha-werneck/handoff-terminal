#!/usr/bin/env python3
"""handoff-done <id> ok|error "<one short sentence, no secrets>"

Run by the terminal session when the sign-in step is over. Records the result that the
desktop app is waiting for, then closes this tmux session 20 seconds later (only when
the session was started for a hand-off, in tmux or without a window).
HANDOFF_NO_CLOSE=1 keeps the session open.
"""
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import common as c  # noqa: E402

# Hand-off sessions always have "handoff" in their name (the hook names them "handoff <site> HHMM").
OWN_SESSION = re.compile(r"(^|-)handoff-")


def close_later(command, label):
    subprocess.Popen(["/bin/sh", "-c", "sleep 20; exec " + command[0], "sh"] + command[1:],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    print("this terminal session (%s) closes in 20 s" % label)


def close_windowless_session():
    """Sessions started without tmux: handoff-launch exported HANDOFF_PGID."""
    pgid = os.environ.get("HANDOFF_PGID", "")
    if not pgid.isdigit() or int(pgid) <= 1:
        return
    try:
        cmd = subprocess.run(["ps", "-ww", "-o", "command=", "-p", pgid], capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return
    if "HANDOFF_CHILD=1" in cmd:  # only a group that handoff-launch started
        close_later(['kill -TERM -- "-$1"', pgid], "process group %s" % pgid)


def close_own_session():
    if os.environ.get("HANDOFF_NO_CLOSE"):
        return
    if os.name == "nt":
        print("you can close this window now")
        return
    pane = os.environ.get("TMUX_PANE")
    if not (os.environ.get("TMUX") and pane):
        close_windowless_session()
        return
    try:
        out = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#{session_id} #{session_name}"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return
    sid, _, sname = out.partition(" ")
    if not sid.startswith("$") or not OWN_SESSION.search(sname):
        return
    # session_id ($N) never changes for the life of the session, unlike its name.
    close_later(['tmux kill-session -t "$1"', sid], sname)


def main():
    args = sys.argv[1:]
    if len(args) < 2 or not c.valid_id(args[0]) or args[1] not in ("ok", "error"):
        print(__doc__.strip())
        return 2
    hid, status = args[0], args[1]
    note = c.one_line(" ".join(args[2:]), 300)
    c.ensure_state()
    c.write_private(c.result_path(hid), json.dumps(
        {"id": hid, "status": status, "note": note, "at": time.strftime("%Y-%m-%d %H:%M:%S")},
        ensure_ascii=False))
    c.log("done id=%s status=%s" % (hid, status))
    print("recorded %s for hand-off %s" % (status, hid))
    close_own_session()
    return 0


if __name__ == "__main__":
    sys.exit(main())
