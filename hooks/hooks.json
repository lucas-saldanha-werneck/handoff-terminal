{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/shortcut.py"], "timeout": 40 },
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/nudge.py"], "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*(request_credentials|autofill_credential)",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/nudge.py"], "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*(request_credentials|autofill_credential)",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/nudge.py"], "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop.py"], "timeout": 45 }
        ]
      }
    ]
  }
}
